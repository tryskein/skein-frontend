{
  "name": "skein-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React SPA for Skein — centralized task tracker",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
